# Linux versions tested
# g++ : 13.3.0
# cmake : 3.28.3

buildDir=".\build"

rm -rf $buildDir
mkdir $buildDir

# CMake presets project generation.
cmake --preset linux-make
cd $buildDir

#
# Sample commands:
# * Build: cmake --build . [--config Debug/Release] [-j]
# * Test: ctest -C Debug/Release
# * Clean: cmake --build . --config Debug/Release --target clean
# * Run: cmake --build . --config Debug/Release --target run
#
