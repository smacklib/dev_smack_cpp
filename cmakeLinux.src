# Development setup for Linux.
#
buildDir=build

rm -rf $buildDir
mkdir $buildDir
cd $buildDir

# Generation of tests and examples is enabled.
cmake \
    -G "Unix Makefiles" \
    -DCMAKE_C_COMPILER=/usr/bin/gcc \
    -DCMAKE_CXX_COMPILER=/usr/bin/g++ \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DENABLE_TESTS=ON \
    -DENABLE_EXAMPLES=ON \
    ..
